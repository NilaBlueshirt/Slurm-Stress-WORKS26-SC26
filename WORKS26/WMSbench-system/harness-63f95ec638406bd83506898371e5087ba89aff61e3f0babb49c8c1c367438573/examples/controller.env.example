#!/usr/bin/env bash
# Controller-root settings for WORKS26. Copy this file outside the repository,
# fill every placeholder, then source it as root on the Slurm controller.

# Harness and identity. This trusted file is sourced by root: install the
# filled copy as root:root mode 0600. Venue is a run_rep.sh argument.
# Install a root-owned, group/world-nonwritable campaign snapshot. This path
# must be the same readable path on the controller and main compute allocation
# because the pseudo batch scripts source their shared body.
export WMSbench_HARNESS_ROOT="/absolute/shared/path/to/bench-WORKS26"
export WMSbench_CLUSTER="FILL_IN_SLURM_CLUSTER_NAME"
export WMSbench_BENCH_USER="FILL_IN_BENCHMARK_USER"
export WMSbench_ACCOUNT="FILL_IN_DEDICATED_ACCOUNT"
export WMSbench_PARTITION="FILL_IN"
export WMSbench_QOS=""
export WMSbench_NODE_CONSTRAINT="FILL_IN_ONE_NODE_TYPE"

# These roots must be different. Monitoring artifacts belong under the first
# root; Nextflow results, work, trace, and logs belong under the second root.
# The batch node writes only handoff/ below this otherwise root-owned tree, so
# this root must be visible from both slurmctld and the submitted main job.
export WMSbench_MONITOR_ROOT="/absolute/shared/path/works26-monitor"
export WMSbench_PIPELINE_ROOT="/absolute/shared/path/works26-pipeline-runs"
export WMSbench_LOCK_ROOT="/absolute/root-owned/path/works26-locks"

# The campaign is declared as N=3 even when only rep1 is collected tonight.
export WMSbench_DECLARED_N=3
export WMSbench_CAP_SECONDS=28800
export WMSbench_PRE_BASELINE_SECONDS=0
# Fixed no-RPC release-settle tail before the final controller boundary.
export WMSbench_POST_BASELINE_SECONDS=30
export WMSbench_UTC_GUARD_SECONDS=900
export WMSbench_SDIAG_INTERVAL_SECONDS=300
export WMSbench_MARKER_POLL_SECONDS=5
export WMSbench_CANCEL_GRACE_SECONDS=120
export WMSbench_AUTO_WAIT_FOR_UTC_RESET=1
# Time of day, in UTC, at which this venue's slurmctld rolls the sdiag
# cumulative-statistics generation. A trial is refused unless the whole safety
# cap fits before the next roll, and the replicate driver waits for the fresh
# generation before retrying.
#
# Confirm it per cluster instead of assuming, because `sdiag` prints its
# `Data since` line in the controller node's LOCAL zone, not in UTC:
#
#   sdiag | head -3
#   Data since      Tue Aug 04 17:00:00 2026 (1785888000)
#
# On an America/Phoenix controller that local 17:00 is 00:00 UTC. Read the
# bracketed epoch rather than the rendered text: an epoch exactly divisible by
# 86400 is a 00:00 UTC roll.
export WMSbench_SDIAG_GENERATION_ROLL_UTC="00:00"

# Controller commands. Keep sdiag cadence at 300 seconds or longer. These are
# command names/paths, not pipeline commands.
export WMSbench_SDIAG_COMMAND="/usr/bin/sdiag"
export WMSbench_SSHARE_COMMAND="/usr/bin/sshare"
export WMSbench_SQUEUE_COMMAND="/usr/bin/squeue"
export WMSbench_SACCTMGR_COMMAND="/usr/bin/sacctmgr"
export WMSbench_SBATCH_COMMAND="/usr/bin/sbatch"
export WMSbench_SCANCEL_COMMAND="/usr/bin/scancel"
export WMSbench_TIMEOUT_COMMAND="/usr/bin/timeout"
export WMSbench_COMMAND_TIMEOUT_SECONDS=120
export WMSbench_TIMEOUT_KILL_AFTER_SECONDS=10
export WMSbench_FAIRSHARE_VERIFY_SECONDS=120
export WMSbench_FAIRSHARE_HIERARCHY=none

# The bundled reset helper resets this benchmark user's association in the
# account, verifies zero, and refuses if that user still has a job.

# Source the filled pipeline environment before launching a replicate.
export WMSbench_PIPELINE_ENV_FILE="/absolute/path/to/pipeline.env"

# Endpoint/trace admission contract. Keep identical at both venues.
export WMSbench_ENDPOINT_PROCESS="FILL_IN_EXACT_LASTZ_PROCESS_NAME"
export WMSbench_ENDPOINT_LOGICAL_KEY_COLUMN="name"
export WMSbench_ALLOWED_PROCESS_REGEX='FILL_IN_FULLMATCH_REGEX_THROUGH_LASTZ'
export WMSbench_TRACE_TIMEZONE="America/Phoenix"

# Manual runner only. A manually stopped pipeline keeps working past LASTZ
# until the operator cancels it, so its trace carries rows for the stage that
# follows the endpoint. Name those processes here with a full-match regular
# expression and they are separated out of the measured workload instead of
# rejecting the run. How far each run got past the endpoint is operator
# reaction time and is allowed to differ between runs; this declared regex is
# not. Leave it empty for the automated runner, whose stage-limited pipeline
# must contain nothing beyond WMSbench_ALLOWED_PROCESS_REGEX.
export WMSbench_POST_ENDPOINT_PROCESS_REGEX=''

# Five user-owned batch entry points. The controller submits each one as the
# benchmark user and writes Slurm monitoring elsewhere under MONITOR_ROOT.
export WMSbench_SBATCH_NATIVE="/absolute/path/to/examples/native.sbatch"
export WMSbench_SBATCH_JOBARRAY="/absolute/path/to/examples/jobarray.sbatch"
export WMSbench_SBATCH_HYPERQUEUE="/absolute/path/to/examples/hyperqueue.sbatch"
export WMSbench_SBATCH_FLUX="/absolute/path/to/examples/flux.sbatch"
export WMSbench_SBATCH_LOCAL="/absolute/path/to/examples/local.sbatch"

# Optional semantic admission check, run after Nextflow and outside measured
# endpoint walltime. Name one executable validator wrapper (no inline shell
# command or arguments). Install it and its direct parent as root-owned,
# group/world-nonwritable, and symlink-free. Root freezes/hashes it before t0; the controller
# supplies WMSbench_PIPELINE_RUN_DIR and WMSbench_MONITOR_RUN_DIR when it runs.
export WMSbench_VALIDATION_COMMAND="/absolute/path/to/validate_lastz_outputs.sh"

# Slurm options are passed on the sbatch command line because #SBATCH does not
# expand shell variables. Common options describe the launcher allocation;
# backend arrays may add literal resource-envelope options.
WMSbench_SBATCH_COMMON_ARGS=(--nodes=1 --ntasks=1 --cpus-per-task=1 --time=08:30:00)
# Native, Job Array, and HyperQueue place only a driver in this allocation:
# native and Job Array dispatch tasks as separate Slurm jobs, and HyperQueue
# acquires its worker envelope through its own allocation queue.
WMSbench_SBATCH_NATIVE_ARGS=()
WMSbench_SBATCH_JOBARRAY_ARGS=()
WMSbench_SBATCH_HYPERQUEUE_ARGS=()
# Flux runs its nested instance inside this allocation, so the Flux treatment
# reserves the whole node envelope here. The node count must equal the pipeline
# environment's WMSbench_FLUX_NODES; the batch script refuses a mismatch. Repeat
# the common options that must change, since a later option wins.
WMSbench_SBATCH_FLUX_ARGS=(--nodes=FILL_IN_K --ntasks=FILL_IN_K --ntasks-per-node=1 --cpus-per-task=FILL_IN_NODE_CPUS)
# Local runs the whole pipeline as OS processes on this one node, so it must
# reserve the real node geometry that local.config declares to Nextflow.
WMSbench_SBATCH_LOCAL_ARGS=(--cpus-per-task=FILL_IN_NODE_CPUS)
