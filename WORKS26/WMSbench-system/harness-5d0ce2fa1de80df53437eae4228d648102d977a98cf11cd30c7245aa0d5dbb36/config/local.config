// Local execution within one exclusive Slurm node using site-specific caps.

def works26LocalCpus = (System.getenv('WMSbench_LOCAL_CPUS') ?: '120') as int
def works26NodeMemory = System.getenv('WMSbench_NODE_MEMORY') ?: '480 GB'

process {
    executor = 'local'

    withName: '.*:LASTZ' {
        // Clear inherited limits; Nextflow 26.04 can abort while reaping a timed-out local task.
        array        = 0
        beforeScript = ''
        cpus         = 1
        memory       = { 4.GB * task.attempt }
        time         = null
    }

    withLabel: 'process_fast' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = null
    }
}

executor {
    name      = 'local'
    cpus      = works26LocalCpus
    memory    = works26NodeMemory
    queueSize = 128
}
