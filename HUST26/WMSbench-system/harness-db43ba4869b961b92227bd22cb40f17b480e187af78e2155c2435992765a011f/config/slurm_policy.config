// Common Slurm placement policy for the native and job-array treatments.
// The login-side launcher exports the same partition/account/QOS/node feature
// used by the enclosing HQ, Flux, and local allocations.  This controls node
// class without pretending that native per-task allocations and bulk
// allocations have identical scheduling architectures.

def works26Partition = System.getenv('WMSbench_PARTITION') ?: 'public'
def works26Account = System.getenv('WMSbench_ACCOUNT') ?: ''
def works26Qos = System.getenv('WMSbench_QOS') ?: ''
def works26Constraint = System.getenv('WMSbench_NODE_CONSTRAINT') ?: ''
def works26Extra = System.getenv('WMSbench_SLURM_TASK_EXTRA') ?: ''

def works26ClusterOptions = []
if (works26Account)    works26ClusterOptions << "--account=${works26Account}"
if (works26Qos)        works26ClusterOptions << "--qos=${works26Qos}"
if (works26Constraint && works26Constraint != 'none')
    works26ClusterOptions << "--constraint=${works26Constraint}"
if (works26Extra)      works26ClusterOptions << works26Extra

process {
    queue = works26Partition
    if (works26ClusterOptions) {
        clusterOptions = works26ClusterOptions.join(' ')
    }
}
