profiles {
    hyperqueue {
        process {
            executor = 'hq'

            withName: '.*:LASTZ' {
                array = 0
                beforeScript = ''
            }

            withLabel: 'process_fast' {
                cpus   = 1
                memory = { 4.GB * task.attempt }
                time   = { 15.min * task.attempt }
            }
        }

        executor {
            name      = 'hq'
            queueSize = 10000
        }
    }
}
