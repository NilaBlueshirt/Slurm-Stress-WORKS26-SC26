#!/usr/bin/env bash
# Pipeline-user settings for a real nf-core-format Nextflow pipeline.
# Copy, fill, and reference it through WMSbench_PIPELINE_ENV_FILE.

export WMSbench_PIPELINE="/absolute/path/to/pipeline-or-nf-core-name"
# Set a revision for a remote project name; leave empty for an already-pinned
# local pipeline checkout.
export WMSbench_PIPELINE_REVISION=""
export WMSbench_NEXTFLOW_COMMAND="nextflow"
# Placement note: nextflow is a software module here, so this name resolves only
# after the module bootstrap below has run.
export WMSbench_PARAMS_FILE="/absolute/path/to/params.json"
export WMSbench_COMMON_CONFIG="/absolute/path/to/common.config"
export WMSbench_STAGE_CONFIG="/absolute/path/to/lastz-stage-only.config"
export WMSbench_TRACE_CONFIG="/absolute/path/to/bench-WORKS26/config/trace.config"
export WMSbench_INPUT_MANIFEST="/absolute/path/to/frozen-input-manifest.json"
export WMSbench_PIPELINE_SOURCE_MANIFEST="/absolute/path/to/frozen-pipeline-source-manifest.json"
export WMSbench_CONFIG_ROOT="/absolute/path/to/bench-WORKS26/config"
export WMSbench_NF_PROFILE="apptainer"

# Record the actual pinned image/digest used by the pipeline configuration.
export WMSbench_CONTAINER_DIGEST="sha256:FILL_IN_64_HEX_DIGEST"

# Resource values consumed by the WORKS26 Nextflow configs. Account,
# partition, QoS, and node type come from the root controller contract and are
# exported into the batch job; do not duplicate them here.
export WMSbench_PHYSICAL_NODE_CPUS=FILL_IN
export WMSbench_PHYSICAL_NODE_MEMORY="FILL_IN_GB"
export WMSbench_ALLOCATION_CPUS=FILL_IN
export WMSbench_LOCAL_CPUS=FILL_IN
export WMSbench_NODE_MEMORY="FILL_IN_GB"
export WMSbench_HQ_WORKER_CPUS=FILL_IN
export WMSbench_BULK_NODES=FILL_IN
export WMSbench_ARRAY_SIZE=FILL_IN
export WMSbench_SLURM_QUEUE_SIZE=FILL_IN
export WMSbench_HQ_WORKERS=FILL_IN
export WMSbench_FLUX_NODES=FILL_IN

# ---------------------------------------------------------------------------
# Site tooling.
#
# The controller submits with an explicit --export list, so the batch job starts
# without the site module function. Name the module init script and the pinned
# modules the campaign needs: Nextflow and HyperQueue are software modules,
# Apptainer provides the runtime for the pipeline task containers, and Mamba
# provides the environment that holds Flux. Pin versions so all three replicates
# load identical tooling; the loaded list is recorded in
# handoff/pipeline_contract.env.
export WMSbench_MODULE_INIT="/usr/share/lmod/lmod/init/bash"
WMSbench_MODULES=(nextflow/FILL_IN hyperqueue/FILL_IN apptainer/FILL_IN mamba/FILL_IN)

# HyperQueue: a plain binary from the module above.
export WMSbench_HQ_COMMAND="hq"
export WMSbench_HQ_ALLOC_TIME_LIMIT="8h"
export WMSbench_HQ_BACKLOG=1
export WMSbench_HQ_STARTUP_TIMEOUT_SECONDS=120
export WMSbench_HQ_SHUTDOWN_TIMEOUT_SECONDS=120
# Extra literal sbatch options for HQ worker allocations, such as --mem. Account,
# partition, QoS, node constraint, --nodes=1, and --cpus-per-task already come
# from the controller contract and WMSbench_ALLOCATION_CPUS.
WMSbench_HQ_ALLOC_SBATCH_ARGS=()

# Flux: a Mamba/Conda environment holding flux-core and flux-sched. Build it
# with those two packages only, so activating it cannot shadow the Nextflow
# module's launcher or its JVM.
export WMSbench_FLUX_ENV_PREFIX="/absolute/path/to/envs/flux-wms"
export WMSbench_FLUX_ENV_NAME=""
# Leave WMSbench_CONDA_INIT empty to put the environment's bin directory on PATH
# without activation, which is enough for Conda binaries and touches nothing
# else. Set it to the Conda shell hook when the environment needs its real
# activation scripts.
export WMSbench_CONDA_INIT=""
export WMSbench_CONDA_ACTIVATE_COMMAND="conda activate"
# Frozen environment specification, for example the output of
# `conda list --explicit` captured once before rep1. Its SHA-256 is recorded in
# handoff/pipeline_contract.env as the Flux software provenance. Leave empty to
# omit it.
export WMSbench_FLUX_ENV_MANIFEST="/absolute/path/to/flux-env-explicit.txt"
# Slurm's PMI library, which a Conda-installed flux-core cannot locate on its
# own. Confirm the site path, for example /usr/lib64/slurm/libpmi2.so.
export WMSbench_FLUX_PMI_LIBRARY="/usr/lib64/slurm/libpmi2.so"
export WMSbench_FLUX_SRUN_MPI="pmi2"
# Node-local base for the broker rundir. Keep it short: the instance socket path
# has a hard length limit.
export WMSbench_FLUX_RUNDIR_BASE="/tmp"
export WMSbench_FLUX_STARTUP_TIMEOUT_SECONDS=300
export WMSbench_FLUX_SHUTDOWN_TIMEOUT_SECONDS=120

# Paper mode requires this array to remain empty. Put all pipeline parameters
# in the hashed params file so trailing CLI flags cannot override the frozen
# profile/config/trace/work-directory contract or enable resume.
WMSbench_NEXTFLOW_EXTRA_ARGS=()
